From: William Vinnicombe <william.vinnicombe@raspberrypi.com>
Date: Wed, 12 Aug 2026 11:04:19 +0100
Subject: [PATCH] RISC-V: Never generate misaligned accesses for Hazard3

Hazard3 has no hardware support for misaligned loads and stores: every
misaligned access traps.  Avoiding them is therefore a property of the
core rather than a tuning preference, but at present it is only expressed
as one -- the hazard3 tune entry is aliased to rocket_tune_info, whose
slow_unaligned_access is true, so -mstrict-align merely defaults to on.
-mno-strict-align then turns STRICT_ALIGNMENT back off; what keeps
misaligned accesses out of the generated code after that is only

  riscv_slow_unaligned_access_p = (cpu->tune_param->slow_unaligned_access
				   || TARGET_STRICT_ALIGN);

that is, the tune's opinion that they are expensive, rather than any
rule that they are forbidden.

Force strict alignment whenever the compiler is tuning for Hazard3, even
if -mno-strict-align was given explicitly; warn once in that case.
Targets that tune for something else are unaffected -- in particular
-mtune naming a core with fast misaligned accesses still gets them, even
alongside -mcpu=hazard3-rp2350.

Since misaligned accesses now trap rather than merely being slow, this
also makes Hazard3 predefine __riscv_misaligned_avoid in place of
__riscv_misaligned_slow, which is the accurate macro of the two for
source code that consults them.

gcc/ChangeLog:

	* config/riscv/riscv.cc (riscv_hazard3_target_p): New function.
	(riscv_override_options_internal): Force strict alignment when
	tuning for a Hazard3 core.
---
 gcc/config/riscv/riscv.cc | 37 +++++++++++++++++++++++++++++++++++++
 1 file changed, 37 insertions(+)

--- a/gcc/config/riscv/riscv.cc
+++ b/gcc/config/riscv/riscv.cc
@@ -1037,6 +1037,19 @@ riscv_parse_tune (const char *tune_string, bool null_p)
   return riscv_tune_info_table;
 }

+/* Return true if OPTS tunes for a Hazard3 core.  Hazard3 has no hardware
+   support for misaligned loads and stores, so misaligned accesses must
+   never be generated for it.  */
+
+static bool
+riscv_hazard3_target_p (const struct gcc_options *opts)
+{
+  const struct riscv_tune_info *tune
+    = riscv_parse_tune (get_tune_str (opts), true);
+
+  return tune && strcmp (tune->name, "hazard3") == 0;
+}
+
 /* Helper function for riscv_build_integer; arguments are as for
    riscv_build_integer.  */

@@ -12325,6 +12338,30 @@ riscv_override_options_internal (struct gcc_options *opts)
       && cpu->tune_param->slow_unaligned_access)
     opts->x_target_flags |= MASK_STRICT_ALIGN;

+  /* Hazard3 traps on every misaligned load and store, so avoiding them is a
+     property of the core rather than a tuning preference.  Force strict
+     alignment whenever we are tuning for Hazard3, even if -mno-strict-align
+     was given explicitly.  */
+  if (riscv_hazard3_target_p (opts))
+    {
+      /* Warn once for the command line rather than again for every function
+	 carrying a target attribute or pragma.  */
+      static bool warned_strict_align = false;
+
+      if ((target_flags_explicit & MASK_STRICT_ALIGN) != 0
+	  && !TARGET_STRICT_ALIGN_OPTS_P (opts)
+	  && !warned_strict_align)
+	{
+	  warned_strict_align = true;
+	  warning (0, "%<-mno-strict-align%> is not supported when targeting "
+		   "Hazard3, which traps on misaligned accesses");
+	}
+
+      opts->x_target_flags |= MASK_STRICT_ALIGN;
+      riscv_slow_unaligned_access_p = true;
+      riscv_user_wants_strict_align = true;
+    }
+
   /* If the user hasn't specified a branch cost, use the processor's
      default.  */
   if (opts->x_riscv_branch_cost == 0)
